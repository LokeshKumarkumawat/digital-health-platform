# ==============================================================================
# .gitignore — Terraform Project
# ==============================================================================

# Local state (never commit — use remote backend)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files with real values (NEVER commit)
*.tfvars
!*.tfvars.example          # Example files are safe to commit

# Terraform working directories
.terraform/
.terraform.lock.hcl        # Commit this if you want reproducible provider versions

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db